# Example environment values
# Copy to .env and edit if you want to expose different ports or custom values.

# Host ports exposed to your LAN
FRONTEND_PORT=6969
BACKEND_PORT=6962

# Optional: default admin user & password for initial setup (change after first login)
# ADMIN_USER=admin
# ADMIN_PASSWORD=admin

# Optional: ALLOWED_ORIGINS (comma-separated). Defaults to '*' to allow LAN access.
# Use a comma-separated list of origins (e.g. http://192.168.1.10:6969)
ALLOWED_ORIGINS=*

# Optional: change data dir inside container
# SERVICE_TRACKER_DATA_DIR=/app/data
