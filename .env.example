# Example environment values
# Copy to .env and edit if you want to expose different ports or custom values

# FRONTEND_PORT=8080
# BACKEND_PORT=8000
# SERVICE_TRACKER_EMAIL_ENABLED=true
# SERVICE_TRACKER_SMTP_HOST=smtp.gmail.com
# SERVICE_TRACKER_SMTP_PORT=587
# SERVICE_TRACKER_SMTP_USERNAME=you@example.com
# SERVICE_TRACKER_SMTP_PASSWORD=your-app-password
# SERVICE_TRACKER_FROM_EMAIL=you@example.com
# SERVICE_TRACKER_TO_EMAIL=alerts@example.com
# SERVICE_TRACKER_SMTP_USE_TLS=true
